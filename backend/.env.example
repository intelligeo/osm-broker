# ── Backend .env ─────────────────────────────────────────────────────────────
# Copia in backend/.env e valorizza le variabili.
# MAI committare questo file con valori reali.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Imposta a true per attivare l'autenticazione OSM OAuth2
AUTH_ENABLED=true

# Chiave per firmare i session JWT interni — genera con: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# OSM OAuth2 — registra l'app su https://www.openstreetmap.org/oauth2/applications
# ⚠ Lascia "Confidential application?" DESELEZIONATO (public client / PKCE)
# ⚠ Scope richiesto: read_prefs
OSM_OAUTH_CLIENT_ID=

# URL backend a cui OSM NON redirige più (flusso singlepage: il callback va al frontend)
# Questo campo è usato solo per reference / documentazione
OSM_OAUTH_CALLBACK_URL=https://osm-broker.onrender.com/api/auth/callback

# URL del frontend — usato per redirect post-login se necessario
FRONTEND_URL=https://osm-broker.onrender.com

# Durata session JWT in minuti (default 60)
JWT_EXPIRE_MINUTES=60

# TTL sessione utente in Redis in secondi (default 3600 = 1h)
SESSION_TTL_SECONDS=3600

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── HOT Raw Data API ──────────────────────────────────────────────────────────
HOT_RAW_DATA_API_URL=https://api-prod.raw-data.hotosm.org/v1

# ── Limits ───────────────────────────────────────────────────────────────────
MAX_AREA_KM2=500.0
