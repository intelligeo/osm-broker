# ── Frontend (Vite) ────────────────────────────────────────────────────────
# URL del backend in sviluppo (Vite proxy reindirizza /api → qui)
VITE_API_URL=http://localhost:8000/api

# Attiva il pulsante di login OAuth2 nel Navbar
VITE_AUTH_ENABLED=true


# ── Backend (FastAPI) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# raw-data-api HOT — endpoint pubblico (nessuna chiave richiesta per uso base)
HOT_RAW_DATA_API_URL=https://api-prod.raw-data.hotosm.org/v1

# Limite area in km² per richiesta
MAX_AREA_KM2=25

# OAuth2 — preparato ma disabilitato; attivare quando pronto
AUTH_ENABLED=false
# OSM_OAUTH_CLIENT_ID=
# OSM_OAUTH_CLIENT_SECRET=
# JWT_SECRET_KEY=change-me-in-production


# ── Worker ─────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
