# ── Frontend .env ─────────────────────────────────────────────────────────────
# Copia in frontend/.env.local e valorizza le variabili.
# Le variabili VITE_* sono incorporate nel bundle al build-time.
# MAI committare valori segreti.

# URL base dell'API backend (senza slash finale)
# In sviluppo locale lascia vuoto: Vite proxy /api → http://localhost:8000
VITE_API_URL=http://localhost:8000

# ── Auth OSM (OAuth2 PKCE, singlepage) ───────────────────────────────────────
# Imposta a "true" per mostrare il pulsante Sign in e attivare il flusso OAuth
VITE_AUTH_ENABLED=true

# Client ID dell'app OAuth2 registrata su openstreetmap.org
# (stesso valore di OSM_OAUTH_CLIENT_ID nel backend)
VITE_OSM_CLIENT_ID=

# ── Come registrare l'app su OSM ─────────────────────────────────────────────
# 1. Vai su https://www.openstreetmap.org → My Settings → OAuth 2 applications
# 2. "Register new application"
#    - Name: OSM Broker (o come preferisci)
#    - Redirect URIs: https://tuo-dominio.com  (e http://localhost:5173 per dev)
#    - Confidential application? → DESELEZIONATO  (public client / PKCE)
#    - Permissions: Read user preferences  (read_prefs)
# 3. Copia il Client ID qui sopra e in backend/.env
# 4. Imposta VITE_AUTH_ENABLED=true e AUTH_ENABLED=true
